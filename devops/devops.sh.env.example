# cp ~/git/altero/ansible/devops.sh.env.example ~/git/altero/ansible/devops.sh.env
# cd ~ && ln -sf ~/git/altero/ansible/devops.sh ~/devops.sh
# ln -sf ~/git/altero/ansible/devops.sh.env ~/devops.sh.env

# Print messages level: 0=Crit; 1=Error; 2=Warn; 3=Info; 4=Debug
PRINT_LEVEL=3

DEFAULT_ENV="hetzner"
# Project vars
DOCKER_IMAGES_LIST="alpine:latest alpine:3.10 busybox:latest
  nginx:alpine adminer:4
  golang:1.12-alpine node:12-alpine rabbitmq:3.7-management-alpine
  gitlab/gitlab-runner:alpine docker:stable"
GIT_DIR="${HOME}/git/altero"
ANSIBLE_DIR="${GIT_DIR}/ansible"
GIT_REPOS_LIST="ansible
  ies-k8s-config k8s-config
  ms-formula ms-front ms-nsi ms-router ms-te ms-te-transfer "
# GitLab-Runner
GITLAB_RUNNER_CONFIG_DIR="/srv/gitlab-runner/config"
GITLAB_RUNNER_NAME="gitlab-runner"
#  docker run --rm -v ${GITLAB_RUNNER_CONFIG_DIR}:/etc/gitlab-runner -v /var/run/docker.sock:/var/run/docker.sock ${GITLAB_RUNNER_IMAGE} register \
GITLAB_RUNNER_REGISTER_PARAMS=" \
  --non-interactive \
  --executor \"docker\" \
  --docker-image docker:stable \
  --docker-volumes \"/var/run/docker.sock:/var/run/docker.sock\" \
  --url \"%GITLAB_URL%\" \
  --registration-token \"%GITLAB_TOKEN%\" \
  --description \"devops-rasla-pc, dind\" \
  --tag-list \"docker\" \
  --run-untagged=\"false\" \
  --locked=\"true\" \
  --access-level=\"not_protected\" "
#  --paused \
# LOG - log-file
LOG="${GIT_DIR}/devops.log"